<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MacMode.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\MacMode.ico</ApplicationIcon>

    <Product>MacMode</Product>
    <AssemblyTitle>MacMode</AssemblyTitle>
    <Description>Mac-style keyboard shortcuts for Windows</Description>
    <Company>MacMode</Company>
    <Copyright>Copyright © MacMode</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacMode.Core\MacMode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\profiles\default.json" Link="DefaultProfiles\default.json" />
    <EmbeddedResource Include="..\..\profiles\chrome.json" Link="DefaultProfiles\chrome.json" />
    <EmbeddedResource Include="..\..\profiles\vscode.json" Link="DefaultProfiles\vscode.json" />
    <EmbeddedResource Include="..\..\profiles\warp.json" Link="DefaultProfiles\warp.json" />
    <EmbeddedResource Include="..\..\profiles\terminal.json" Link="DefaultProfiles\terminal.json" />
    <EmbeddedResource Include="..\..\profiles\explorer.json" Link="DefaultProfiles\explorer.json" />
  </ItemGroup>

</Project>
